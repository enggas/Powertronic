@model Powertronic.Models.ViewModels.CrearCuentaViewModel

@{
    ViewBag.Title = "Crear Cuenta";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Crear Cuenta - Phone Store</title>
<style> 

            .crear-cuenta-wrapper{
                display:flex;
                justify-content:center;
                align-items:center;
                min-height:80vh;
                padding:30px;
            }

            .crear-cuenta-card{
                width:1100px;
                min-height:700px;
                background:white;
                display:flex;
                border-radius:20px;
                overflow:hidden;
                box-shadow:0 10px 30px rgba(0,0,0,.15);
            }

            /* Lado izquierdo */

            .form-section{
                flex:1;
                padding:50px;
                background:white;
            }

            .form-section h2{
                text-align:center;
                margin-bottom:40px;
                color:var(--secondary-color);
                font-size:3rem;
                font-weight:bold;
            }

            .form-group{
                margin-bottom:15px;
            }

            .form-control{
                height:50px;
                border:none;
                background:#f3f4f6;
                border-radius:10px;
            }

            .form-control:focus{
                border:2px solid var(--accent-color);
                box-shadow:none;
            }

            /* Botón */

            .btn-submit{
                width:100%;
                height:55px;
                border:none;
                border-radius:10px;
                background:var(--primary-color);
                color:white;
                font-size:18px;
                font-weight:600;
                margin-top:20px;
                transition:.3s;
            }

            .btn-submit:hover{
                background:var(--accent-color);
            }

            /* Lado derecho */

            .info-section{
                flex:1;
                background:linear-gradient(
                    135deg,
                    var(--primary-color),
                    var(--accent-color)
                );

                display:flex;
                justify-content:center;
                align-items:center;
                color:white;
                text-align:center;
                padding:40px;
            }

            .info-content h1{
                font-size:3rem;
                margin-bottom:20px;
            }

            .info-content p{
                font-size:1.2rem;
                line-height:1.8;
            }

            .back-login{
                text-align:center;
                margin-top:25px;
            }

            .back-login a{
                color:var(--primary-color);
                text-decoration:none;
                font-weight:bold;
            }

            .back-login a:hover{
                color:var(--accent-color);
            }

</style>

</head>
<body>


    <div class="crear-cuenta-wrapper">

    <div class="crear-cuenta-card">

        <div class="form-section">

            <h2>Crear Cuenta</h2>

            @using (Html.BeginForm("CrearCuenta", "Cuenta", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="form-group">
                @Html.LabelFor(m => m.Nombre, "Nombre del Usuario")
                @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", placeholder = "Ingrese nombre de usuario" })
                @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Apellido, "Apellido del Usuario")
                @Html.TextBoxFor(m => m.Apellido, new { @class = "form-control", placeholder = "Ingrese apellido de usuario" })
                @Html.ValidationMessageFor(m => m.Apellido, "", new { @class = "text-danger" })
            </div>


            <div class="form-group">
                @Html.LabelFor(m => m.Cedula, "Cedula")
                @Html.TextBoxFor(m => m.Cedula, new { @class = "form-control", type = "tel", placeholder = "Ingrese su numero de cédula" })
                @Html.ValidationMessageFor(m => m.Cedula, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Direccion, "Direccion")
                @Html.TextBoxFor(m => m.Direccion, new { @class = "form-control", type = "tel", placeholder = "Ingrese su Direccion" })
                @Html.ValidationMessageFor(m => m.Direccion, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Telefono, "Telefono")
                @Html.TextBoxFor(m => m.Telefono, new { @class = "form-control", type = "tel", placeholder = "Ingrese su numero telefonico" })
                @Html.ValidationMessageFor(m => m.Telefono, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Gmail, "Correo Electrónico")
                @Html.TextBoxFor(m => m.Gmail, new { @class = "form-control", type = "email", placeholder = "Ingrese su correo electrónico" })
                @Html.ValidationMessageFor(m => m.Gmail, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Password, "Contraseña")
                @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Ingrese una contraseña", id = "Password" })
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label for="ConfirmPassword">Confirmar Contraseña</label>
                <input type="password" id="ConfirmPassword" name="ConfirmPassword" class="form-control" placeholder="Confirme la contraseña" />
                <span id="confirm-error" class="text-danger" style="display:none;">Las contraseñas no coinciden.</span>
            </div>

            <button type="submit" class="btn-submit" id="btn-submit">Crear Cuenta</button>
        }

        <div class="back-login">
            <a href="@Url.Action("Login", "Login")">¿Ya tienes cuenta? Inicia sesión</a>
        </div>

        </div>

        <div class="info-section">

            <div class="info-content">

                <h1>Powertronic</h1>

                <p>
                    Crea tu cuenta y accede a nuestro catálogo de
                    computadoras, componentes, periféricos y las mejores
                    ofertas tecnológicas.
                </p>

                <p>
                    Compra de forma rápida, segura y administra tus pedidos
                    desde un solo lugar.
                </p>

            </div>

        </div>

    </div>

</div>


   

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#btn-submit').click(function (e) {
                const pass = $('#Password').val();
                const confirm = $('#ConfirmPassword').val();

                if (pass !== confirm) {
                    $('#confirm-error').show();
                    e.preventDefault();
                } else {
                    $('#confirm-error').hide();
                }
            });
        });
    </script>
</body>
</html>
