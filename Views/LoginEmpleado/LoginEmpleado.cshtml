@model Powertronic.Models.Empleado

@{
    ViewBag.Title = "Iniciar Sesión";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Login - Phone Store</title>
    <style>
     
        .iniciar-sesion-wrapper{
                display:flex;
                justify-content:center;
                align-items:center;
                min-height:80vh;
                padding:30px;
            }

            .iniciar-sesion-card{
                width:1100px;
                min-height:700px;
                background:white;
                display:flex;
                border-radius:20px;
                overflow:hidden;
                box-shadow:0 10px 30px rgba(0,0,0,.15);
            }

            /* Lado izquierdo */

            .form-section{
                flex:1;
                padding:50px;
                background:white;
            }

            .form-section h2{
                text-align:center;
                margin-bottom:40px;
                color:var(--secondary-color);
                font-size:3rem;
                font-weight:bold;
            }

            .form-group{
                margin-bottom:15px;
            }

            .form-control{
                height:50px;
                border:none;
                background:#f3f4f6;
                border-radius:10px;
            }

            .form-control:focus{
                border:2px solid var(--accent-color);
                box-shadow:none;
            }

            /* Botón */

            .btn-submit{
                width:100%;
                height:55px;
                border:none;
                border-radius:10px;
                background:var(--primary-color);
                color:white;
                font-size:18px;
                font-weight:600;
                margin-top:20px;
                transition:.3s;
            }

            .btn-submit:hover{
                background:var(--accent-color);
            }

            /* Lado derecho */

            .info-section{
                flex:1;
                background:linear-gradient(
                    135deg,
                    var(--primary-color),
                    var(--accent-color)
                );

                display:flex;
                justify-content:center;
                align-items:center;
                color:white;
                text-align:center;
                padding:40px;
            }

            .info-content h1{
                font-size:3rem;
                margin-bottom:20px;
            }

            .info-content p{
                font-size:1.2rem;
                line-height:1.8;
            }

            .back-login{
                text-align:center;
                margin-top:25px;
            }

            .back-login a{
                color:var(--primary-color);
                text-decoration:none;
                font-weight:bold;
            }

            .back-login a:hover{
                color:var(--accent-color);
            }

            .btn-login{
    width:100%;
    height:55px;
    border:none;
    border-radius:10px;
    background:var(--primary-color);
    color:white;
    font-size:18px;
    font-weight:600;
    margin-top:20px;
    transition:.3s;
}

.btn-login:hover{
    background:var(--accent-color);
}

.links-container{
    margin-top:25px;
    display:flex;
    flex-direction:column;
    gap:10px;
}

.forgot-password{
    text-decoration:none;
    color:var(--primary-color);
    font-weight:500;
    text-align:center;
}

.forgot-password:hover{
    color:var(--accent-color);
}

.error-message{
    margin-top:20px;
    padding:12px;
    border-radius:10px;
    background:#ffe5e5;
    color:#c62828;
    text-align:center;
}

.btn-volver{
    display:block;
    text-align:center;
    margin-top:20px;
    padding:12px;
    border-radius:10px;
    text-decoration:none;
    background:var(--secondary-color);
    color:white;
    transition:.3s;
}

.btn-volver:hover{
    background:var(--primary-color);
    color:white;
}

.text-danger{
    color:#dc3545;
    font-size:14px;
}

.info-content{
    max-width:450px;
}

.info-content h1{
    font-size:3rem;
    font-weight:bold;
    margin-bottom:25px;
}

.info-content p{
    font-size:1.1rem;
    line-height:1.8;
}

        
 
     
    </style>
</head>
<body>

    <div class="iniciar-sesion-wrapper">

    <div class="iniciar-sesion-card">

        <!-- PANEL IZQUIERDO -->
        <div class="form-section">

            <h2>Iniciar Sesión</h2>

            @using (Html.BeginForm("LoginEmpleado", "LoginEmpleado", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="form-group">
                @Html.LabelFor(m => m.Gmail, "Correo")
                @Html.TextBoxFor(m => m.Gmail, new { @class = "form-control", placeholder = "Ingrese su correo electrónico" })
                @Html.ValidationMessageFor(m => m.Gmail, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Contraseña, "Contraseña")
                @Html.PasswordFor(m => m.Contraseña, new { @class = "form-control", placeholder = "Ingrese su contraseña" })
                @Html.ValidationMessageFor(m => m.Contraseña, "", new { @class = "text-danger" })
            </div>

            <button type="submit" class="btn-login">Iniciar Sesión</button>
        }


        @if (!string.IsNullOrEmpty(ViewBag.Error as string))
        {
            <div class="error-message">@ViewBag.Error</div>
        }

         <a href="@Url.Action("Index", "Home")" class="btn-volver">
    ←       Volver al menú principal
        </a>




        </div>

        <!-- PANEL DERECHO -->
        <div class="info-section">

            <div class="info-content">

                <h1>Powertronic Staff</h1>

                <p>
                    Inicia sesión para acceder a los recursos internos de la empresa.
                </p>

                <p>
                    Gestiona productos, clientes, pedidos y procesos operativos de manera eficiente desde cualquier lugar y en cualquier momento.
                </p>

            </div>

        </div>

    </div>

</div>

    <!-- Scripts de validación obligatorios -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
