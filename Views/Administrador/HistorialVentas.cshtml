@model IEnumerable<Powertronic.Models.ViewModels.HistorialVentasVM>

@{
    ViewData["Title"] = "HistorialVentas";
}

<style>

    .catalog-search {
        margin-bottom: 25px;
    }

        .catalog-search form {
            display: flex;
            gap: 10px;
        }

    .search-box {
        flex: 1;
        padding: 12px;
        border-radius: 8px;
        border: 1px solid #ddd;
    }

    .search-btn {
        background: var(--primary-color);
        color: white;
        border: none;
        padding: 12px 20px;
        border-radius: 8px;
    }

        .search-btn:hover {
            background: var(--accent-color);
        }

    .venta-card {
        background: white;
        margin-bottom: 25px;
        border: 1px solid #ddd;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,.08);
    }

    .venta-header {
        background: var(--secondary-color);
        color: white;
        padding: 15px 25px;
        font-size: 24px;
        font-weight: bold;
    }

    .venta-body {
        padding: 20px;
    }

    .venta-details {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
    }

    .left-column,
    .right-column {
        width: 48%;
    }

        .left-column p,
        .right-column p {
            margin-bottom: 10px;
        }

    .payment-section {
        margin-top: 20px;
        padding-top: 15px;
        border-top: 1px solid #ddd;
    }

    .payment-card {
        margin-top: 15px;
        padding: 15px;
        background: #f8f9fa;
        border-left: 5px solid var(--primary-color);
        border-radius: 8px;
    }

        .payment-card h5 {
            color: var(--secondary-color);
            margin-bottom: 15px;
        }

    .productos-section {
        margin-top: 25px;
        border-top: 1px solid #ddd;
        padding-top: 20px;
    }

        .productos-section h5 {
            color: var(--secondary-color);
            margin-bottom: 15px;
        }

    .productos-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
    }

    .producto-mini {
        width: 140px;
        text-align: center;
    }

        .producto-mini img {
            width: 100%;
            height: 120px;
            object-fit: contain;
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 5px;
            background: white;
        }

        .producto-mini span {
            display: block;
            margin-top: 8px;
            font-size: 13px;
            font-weight: 600;
        }

        .producto-mini small {
            display: block;
            color: #666;
        }

</style>

<div class="catalog-search">

    <form asp-action="HistorialVentas" method="get">

        <input type="text"
               name="buscar"
               class="search-box"
               placeholder="Buscar por factura o cliente..." />

        <button type="submit" class="search-btn">
            Buscar
        </button>

    </form>

</div>

@foreach (var item in Model)
{
    <div class="venta-card">

        <div class="venta-header">
            Factura #@item.NumeroFactura
        </div>

        <div class="venta-body">

            <div class="venta-details">

                <div class="left-column">

                    <p>
                        <strong>Cliente:</strong>
                        @item.ClienteNombre
                    </p>

                    <p>
                        <strong>Fecha:</strong>
                        @item.Venta.FechaCreacion.ToString("dd/MM/yyyy")
                    </p>

                    <p>
                        <strong>Método de Pago:</strong>
                        @item.TipoPagoNombre
                    </p>

                </div>

                <div class="right-column">

                    <p>
                        <strong>ID Venta:</strong>
                        @item.Venta.Id
                    </p>

                    <p>
                        <strong>Productos:</strong>
                        @item.Venta.det_Ventas.Count
                    </p>

                    <p>
                        <strong>Total Facturado:</strong>
                        C$ @item.Venta.TotalVenta.ToString("N2")
                    </p>

                </div>

            </div>

            @if (item.TipoPagoId == 2 || item.TipoPagoId == 3)
            {
                <div class="payment-section">

                    <div class="payment-card">

                        <h5>Información de Tarjeta</h5>

                        <p>
                            <strong>Tipo:</strong>
                            @item.TipoPagoNombre
                        </p>

                        <p>
                            <strong>Marca:</strong>
                            @item.MarcaTarjeta
                        </p>

                        <p>
                            <strong>Terminación:</strong>
                            **** @item.Ultimos4
                        </p>

                        <p>
                            <strong>Monto Procesado:</strong>
                            C$ @item.MontoTarjeta?.ToString("N2")
                        </p>

                        <p>
                            <strong>Fecha del Pago:</strong>
                            @item.FechaPagoTarjeta?.ToString("dd/MM/yyyy HH:mm")
                        </p>

                    </div>

                </div>
            }

            <div class="productos-section">

                <h5>Productos Vendidos</h5>

                <div class="productos-grid">

                    @foreach (var detalle in item.Venta.det_Ventas)
                    {
                        <div class="producto-mini">

                            <img src="@detalle.Producto?.ImagenUrl"
                                 alt="@detalle.Producto?.Nombre" />

                            <span>
                                @detalle.Producto?.Nombre
                            </span>

                            <small>
                                Cantidad: @detalle.Cantidad
                            </small>

                            <small>
                                C$ @detalle.TotalVenta.ToString("N2")
                            </small>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>
}