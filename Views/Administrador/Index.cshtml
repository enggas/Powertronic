@model Powertronic.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<style>

    .dashboard-container{
        display:flex;
        min-height:85vh;
    }

    .sidebar{
        width:260px;
        background:#0A192F;
        color:white;
        padding:20px;
    }

    .sidebar h4{
        margin-bottom:30px;
    }

    .sidebar a{
        display:block;
        color:white;
        text-decoration:none;
        padding:12px;
        margin-bottom:10px;
        border-radius:8px;
    }

    .sidebar a:hover{
        background:#3006c6;
    }

    .content{
        flex:1;
        padding:20px;
        background:#f4f7fc;
    }

    .card-dashboard{
        background:white;
        border-radius:15px;
        padding:20px;
        box-shadow:0 2px 8px rgba(0,0,0,.1);
    }

    .stats-grid{
        display:grid;
        grid-template-columns:repeat(2,1fr);
        gap:20px;
        margin-bottom:20px;
    }

    .employee-card{
        cursor:pointer;
    }

    .employee-item{
        border-bottom:1px solid #eee;
        padding:10px;
    }

    .employee-item:last-child{
        border-bottom:none;
    }

    .quick-sale{
        background:#3006c6;
        color:white;
        text-align:center;
        text-decoration:none;
        display:flex;
        align-items:center;
        justify-content:center;
        font-size:24px;
        font-weight:bold;
        min-height:200px;
        border-radius:15px;
    }

    .quick-sale:hover{
        background:#00a6ff;
        color:white;
    }

</style>

<div class="dashboard-container">

    <div class="sidebar">

        <h4>Powertronic</h4>

        <a asp-controller="Administrador" asp-action="ListProveedores">
            Administrar Proveedores
        </a>

        <a asp-controller="Administrador" asp-action="ListClientes">
            Administrar Clientes
        </a>

        <a asp-controller="Administrador" asp-action="ListProducto">
            Administrar Inventario
        </a>

        <a asp-controller="Administrador" asp-action="ListAdquisiciones">
            Historial de Adquisiciones
        </a>

        <a asp-controller="Administrador" asp-action="HistorialVentas">
            Historial de Ventas
        </a>

        <a asp-controller="Administrador" asp-action="ListOrdenReparacion">
            Historial de Ordenes de Reparación
        </a>

    </div>

    <div class="content">

        <div class="stats-grid">

            <!-- Empleados -->

            <a asp-controller="Empleado"
               asp-action="Index"
               style="text-decoration:none;color:inherit;">

                <div class="card-dashboard employee-card">

                    <h4>Empleados</h4>

                    @foreach (var emp in Model.Empleados)
                    {
                        <div class="employee-item">

                            <strong>
                                @emp.Nombre @emp.Apellido
                            </strong>

                            <br />

                            <small>
                                @emp.Cargo.Descripcion
                            </small>

                        </div>
                    }

                </div>

            </a>

            <!-- Ganancias y pérdidas -->

            <div class="card-dashboard">

                <h4>Finanzas</h4>

                <hr />

                <h5 style="color:green">
                    Ganancias
                </h5>

                <h3>
                    C$ @Model.TotalGanancias.ToString("N2")
                </h3>

                <h5 style="color:red">
                    Pérdidas
                </h5>

                <h3>
                    C$ @Model.TotalPerdidas.ToString("N2")
                </h3>

            </div>

            <!-- Métodos de pago -->

            <div class="card-dashboard">

                <h4>Ventas por Método de Pago</h4>

                <hr />

                <h5>
                    Efectivo:
                    @Model.VentasEfectivo
                </h5>

                <h5>
                    Tarjeta:
                    @Model.VentasTarjeta
                </h5>

            </div>

            <!-- Botón venta -->

            <a asp-controller="Venta"
               asp-action="Create"
               class="quick-sale">

                Realizar Venta

            </a>

        </div>

    </div>

</div>