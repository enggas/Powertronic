@model Powertronic.Models.Clientes

@{
    ViewData["Title"] = "Crear Cliente";
}

<style>

    .create-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

        .create-header h2 {
            color: var(--secondary-color);
            font-weight: 700;
            margin: 0;
        }

    .create-card {
        background: white;
        border-radius: 12px;
        padding: 30px;
        box-shadow: 0 2px 8px rgba(0,0,0,.08);
        max-width: 700px;
    }

    .form-group {
        margin-bottom: 18px;
    }

    .form-control {
        height: 48px;
        border: 1px solid #ddd;
        background: #f8f9fa;
        border-radius: 8px;
    }

        .form-control:focus {
            border: 2px solid var(--accent-color);
            box-shadow: none;
        }

    .btn-guardar {
        background: var(--primary-color);
        color: white;
        border: none;
        padding: 12px 30px;
        border-radius: 8px;
        font-weight: 600;
        transition: .3s;
    }

        .btn-guardar:hover {
            background: var(--accent-color);
            color: white;
        }

    .btn-volver-lista {
        background: #6c757d;
        color: white;
        text-decoration: none;
        padding: 12px 30px;
        border-radius: 8px;
        font-weight: 600;
        transition: .3s;
    }

        .btn-volver-lista:hover {
            background: #5a6268;
            color: white;
        }

    .form-actions {
        display: flex;
        gap: 15px;
        margin-top: 10px;
    }

</style>

<div class="create-header">
    <h2>Crear Cliente</h2>
</div>

<div class="create-card">

    <form asp-action="CreateCliente" method="post">

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="Cedula" class="control-label">Cédula</label>
            <input asp-for="Cedula" class="form-control" placeholder="000-000000-0000A" />
            <span asp-validation-for="Cedula" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="NombreCliente" class="control-label">Nombre</label>
            <input asp-for="NombreCliente" class="form-control" />
            <span asp-validation-for="NombreCliente" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ApellidoCliente" class="control-label">Apellido</label>
            <input asp-for="ApellidoCliente" class="form-control" />
            <span asp-validation-for="ApellidoCliente" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Telefono" class="control-label">Teléfono</label>
            <input asp-for="Telefono" class="form-control" placeholder="8 dígitos, inicia con 2, 5, 7 u 8" />
            <span asp-validation-for="Telefono" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Gmail" class="control-label">Correo Electrónico</label>
            <input asp-for="Gmail" type="email" class="form-control" />
            <span asp-validation-for="Gmail" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Contraseña" class="control-label">Contraseña</label>
            <input asp-for="Contraseña" type="password" class="form-control" />
            <span asp-validation-for="Contraseña" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Direccion" class="control-label">Dirección</label>
            <input asp-for="Direccion" class="form-control" />
            <span asp-validation-for="Direccion" class="text-danger"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-guardar">Guardar Cliente</button>
            <a asp-action="ListClientes" class="btn-volver-lista">Volver al Listado</a>
        </div>

    </form>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
