@model IEnumerable<Powertronic.Models.Empleado>

@{
    ViewData["Title"] = "ListEmpleado";
}

<style>



    .catalog-search {
        margin-bottom: 25px;
    }

        .catalog-search form {
            display: flex;
            gap: 10px;
        }

    .search-box {
        flex: 1;
        padding: 12px;
        border: 1px solid #ddd;
        border-radius: 8px;
    }

    .search-btn {
        background: var(--primary-color);
        color: white;
        border: none;
        padding: 12px 20px;
        border-radius: 8px;
    }

        .search-btn:hover {
            background: var(--accent-color);
        }

    .register-btn {
        background: #198754;
        color: white;
        border: none;
        padding: 12px 20px;
        border-radius: 8px;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 500;
    }

        .register-btn:hover {
            background: #157347;
            color: white;
        }

    .employee-card {
        background: white;
        border: 1px solid #ddd;
        border-radius: 12px;
        margin-bottom: 20px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,.08);
    }

    .employee-header {
        background: var(--secondary-color);
        color: white;
        padding: 15px 25px;
        font-size: 1.3rem;
        font-weight: bold;
    }

    .employee-body {
        padding: 20px;
    }

    .employee-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(250px,1fr));
        gap: 15px;
    }

    .employee-item {
        background: #f8f9fa;
        padding: 12px;
        border-radius: 8px;
    }

        .employee-item strong {
            color: var(--primary-color);
            display: block;
            margin-bottom: 4px;
        }

    .employee-footer {
        background: #fafafa;
        border-top: 1px solid #ddd;
        padding: 15px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .estado-activo {
        color: #198754;
        font-weight: bold;
    }

    .estado-inactivo {
        color: #dc3545;
        font-weight: bold;
    }

    .btn-admin {
        background: var(--primary-color);
        color: white;
        padding: 8px 15px;
        border-radius: 8px;
        text-decoration: none;
        margin-left: 5px;
    }

        .btn-admin:hover {
            background: var(--accent-color);
            color: white;
        }

</style>

<div class="catalog-search">

    <form asp-action="ListEmpleado" method="get">

        <input type="text"
               name="buscar"
               class="search-box"
               placeholder="Buscar empleado por nombre, apellido, correo o cargo..." />

        <button type="submit" class="search-btn">
            Buscar
        </button>

        <a asp-controller="Administrador"
           asp-action="CreateEmpleado"
           class="register-btn">
            + Registrar Empleado
        </a>

    </form>

</div>

@foreach (var empleado in Model)
{
    <div class="employee-card">

        <div class="employee-header">
            @empleado.Nombre @empleado.Apellido
        </div>

        <div class="employee-body">

            <div class="employee-grid">

                <div class="employee-item">
                    <strong>Código</strong>
                    @empleado.Codigo
                </div>

                <div class="employee-item">
                    <strong>Cédula</strong>
                    @empleado.Cedula
                </div>

                <div class="employee-item">
                    <strong>Cargo</strong>
                    @empleado.Cargo?.NombreCargo
                </div>

                <div class="employee-item">
                    <strong>Descripción del Cargo</strong>
                    @empleado.Cargo?.Descripcion
                </div>

                <div class="employee-item">
                    <strong>Teléfono</strong>
                    @empleado.Telefono
                </div>

                <div class="employee-item">
                    <strong>Correo</strong>
                    @empleado.Gmail
                </div>

                <div class="employee-item">
                    <strong>Dirección</strong>
                    @empleado.Direccion
                </div>

                <div class="employee-item">
                    <strong>Fecha Registro</strong>
                    @empleado.FechaRegistro.ToString("dd/MM/yyyy")
                </div>

            </div>

        </div>

        <div class="employee-footer">

            <span class="@(empleado.Estado ? "estado-activo" : "estado-inactivo")">
                @(empleado.Estado ? "Activo" : "Inactivo")
            </span>

            <div>
                <a asp-action="EditEmpleado"
				   asp-controller="Administrador"
                   asp-route-id="@empleado.Id"
                   class="btn-admin">
                    Editar
                </a>

            </div>

        </div>

    </div>
}

