@model IEnumerable<Powertronic.Models.ViewModels.ProveedorViewModel>

@{
    ViewData["Title"] = "ListProveedores";
}

<style>

    .catalog-search {
        margin-bottom: 25px;
    }

        .catalog-search form {
            display: flex;
            gap: 10px;
        }

    .search-box {
        flex: 1;
        padding: 12px;
        border-radius: 8px;
        border: 1px solid #ddd;
    }

    .search-btn {
        background: var(--primary-color);
        color: white;
        border: none;
        padding: 12px 20px;
        border-radius: 8px;
    }

        .search-btn:hover {
            background: var(--accent-color);
        }

    .product-card {
        display: flex;
        background: white;
        margin-bottom: 20px;
        border: 1px solid #dcdcdc;
        box-shadow: 0 2px 5px rgba(0,0,0,.08);
    }

    .product-image {
        width: 220px;
        border-right: 1px solid #ddd;
    }

        .product-image img {
            width: 100%;
            height: 220px;
            object-fit: contain;
            padding: 10px;
        }

    .product-info {
        flex: 1;
    }

    .product-header {
        background: var(--secondary-color);
        color: white;
        font-size: 28px;
        font-weight: bold;
        padding: 10px 20px;
    }

    .product-details {
        display: flex;
        justify-content: space-between;
        padding: 20px;
    }

    .left-column,
    .right-column {
        width: 45%;
    }

        .left-column p,
        .right-column p {
            margin-bottom: 10px;
        }

    .product-description {
        border-top: 1px solid #ddd;
        padding: 15px 20px;
        background: #fafafa;
    }

    @@media(max - width:768px) {

        .product-card {
            flex-direction: column;
        }

        .product-image {
            width: 100%;
            border-right: none;
            border-bottom: 1px solid #ddd;
        }

        .product-details {
            flex-direction: column;
        }

        .left-column,
        .right-column {
            width: 100%;
        }
    }

    .imagenes-proveedor {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        padding: 20px;
        border-top: 1px solid #ddd;
    }

    .producto-miniatura {
        width: 120px;
        text-align: center;
    }

    .miniatura-producto {
        width: 100px;
        height: 100px;
        object-fit: contain;
        border: 1px solid #ddd;
        border-radius: 10px;
        background: white;
        padding: 5px;
        transition: .3s;
    }

        .miniatura-producto:hover {
            transform: scale(1.1);
        }

    .producto-miniatura span {
        display: block;
        margin-top: 5px;
        font-size: .85rem;
    }

</style>

<div class="catalog-search">

    <form asp-action="ListProveedor"
          asp-controller="Administrador"
          method="get">

        <input type="text"
               name="buscar"
               class="search-box"
               placeholder="Buscar proveedor..." />

        <button type="submit"
                class="search-btn">
            Buscar
        </button>

    </form>

</div>

@foreach (var item in Model)
{
    <div class="product-card">

        <div class="product-info">

            <div class="product-header">
                @item.proveedores.Nombre
            </div>

            <div class="product-details">

                <div class="left-column">

                    <p>
                        <strong>Código:</strong>
                        @item.proveedores.Codigo
                    </p>

                    <p>
                        <strong>Teléfono:</strong>
                        @item.proveedores.Telefono
                    </p>

                </div>

                <div class="right-column">

                    <p>
                        <strong>Estado:</strong>

                        @(item.proveedores.Estado
                                            ? "Activo"
                                            : "Inactivo")
                </p>

                    <p>
                        <strong>Productos:</strong>
                        @item.productos.Count
                    </p>

                </div>

            </div>

            <div class="product-description">

                <strong>Dirección:</strong>

                @item.proveedores.Direccion

            </div>

            <div class="imagenes-proveedor">

            @foreach (var producto in item.productos)
                {
                    <div class="producto-miniatura">

                        <img src="~/pictures/@producto.ImagenUrl"
                             alt="@producto.Nombre"
                             class="miniatura-producto" />

                        <span>
                            @producto.Nombre
                        </span>

                    </div>
                }

            </div>

        </div>

    </div>
}